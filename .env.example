# Flask
SECRET_KEY=your-super-secret-key-here
FLASK_ENV=development

# DB (개발: sqlite, 운영: postgresql)
DATABASE_URL=sqlite:///automarket.db
# DATABASE_URL=postgresql://user:password@host:5432/automarket

# AES-256 암호화 키 (정확히 32바이트 이상)
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# KIS API 모드 (True=모의투자, False=실제투자)
# MOCK_MODE=True  → https://openapivts.koreainvestment.com:29443
# MOCK_MODE=False → https://openapi.koreainvestment.com:9443
MOCK_MODE=True

# 포트
PORT=5000
